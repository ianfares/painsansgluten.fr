APP_NAME="Mon Sans Gluten by Angélique"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB uniquement (jamais PostgreSQL, jamais SQLite en prod — voir CLAUDE.md §2)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=boulangerie_gluten
DB_USERNAME=changeme
DB_PASSWORD=changeme

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@painsansgluten.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Chemin du panneau d'administration Filament (guard "admin", distinct des comptes clients — À VALIDER avec la cliente)
ADMIN_PATH=admin

# Chronopost — Web Service points relais (T01, CRITIQUE J1). Voir PLAN.md §8.2, §27 — identifiants fournis par Ian/contrat Chronopost.
CHRONOPOST_ACCOUNT_NUMBER=changeme
CHRONOPOST_WS_PASSWORD=changeme
CHRONOPOST_PRODUCT_CODE=changeme

# Stripe Checkout hébergé — T14. Clés TEST en local/préprod, LIVE en prod UNIQUEMENT (voir CLAUDE.md §4).
STRIPE_KEY=pk_test_changeme
STRIPE_SECRET=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme

# Brevo — emails transactionnels en queue (T19). Clé API fournie par Ian.
BREVO_API_KEY=changeme
BREVO_SENDER_EMAIL=contact@painsansgluten.fr
BREVO_SENDER_NAME="Mon Sans Gluten by Angélique"

# Analytics — GTM/GA4 (T22, À RENSEIGNER par Ian). Consent Mode v2 : denied par défaut avant chargement GTM.
GTM_ID=GTM-XXXXXXX
GA4_ID=G-XXXXXXXXXX

VITE_APP_NAME="${APP_NAME}"
